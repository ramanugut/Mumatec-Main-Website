{
  "profile": "product-admin",
  "canonicalMap": "UX-CONTRACT.md",
  "sourceRoots": [
    "public"
  ],
  "requiredCapabilities": [
    "Form",
    "Select/Listbox",
    "Scrollbar"
  ],
  "ownership": {
    "Select/Listbox": "native"
  },
  "requiredCommands": [
    "build",
    "test"
  ],
  "commands": {
    "build": "python scripts/build.py && python scripts/check_site.py",
    "test": "node scripts/test_site.cjs && node scripts/test_setup.cjs && node scripts/test_motion.cjs"
  }
}
