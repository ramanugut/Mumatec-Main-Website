DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
# Isolated review build. These local routes do not connect a billing application.
RewriteRule ^billing(?:/.*)?$ /account [R=302,L]
RewriteRule ^free-website-form/?$ /websites [R=301,L]
RewriteRule ^contacts/?$ /contact [R=301,L]
RewriteRule ^web-design/?$ /websites [R=301,L]
RewriteRule ^web-hosting/?$ /hosting [R=301,L]
RewriteRule ^email-hosting/?$ /email [R=301,L]
RewriteRule ^ssl-certificates/?$ /ssl [R=301,L]
RewriteRule ^client-area/?$ /account [R=302,L]
RewriteRule ^(?:terms|privacy|acceptable-use|refund_returns)/?$ /policies [R=302,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z-]+)/?$ $1.html [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
